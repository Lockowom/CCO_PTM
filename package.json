{
  "name": "cco-ptm",
  "private": true,
  "version": "1.55.163",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"tests/**/*.{js,jsx,ts,tsx}\" \"playwright.config.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "quality:gate": "npm run lint && npm run typecheck && npm run test:coverage",
    "prebuild": "node scripts/gen_release_notes.js && node scripts/generate_architecture_catalog.mjs",
    "prepare": "husky install",
    "gen:notes": "node scripts/gen_release_notes.js",
    "gen:architecture": "node scripts/generate_architecture_catalog.mjs",
    "build": "vite build",
    "docs:iam:pptx": "node scripts/generate_iam_tutorial_pptx.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "deploy": "node deploy.js",
    "deploy:mobile": "node scripts/deploy_mobile.js",
    "update:traspasos": "node scripts/update_traspasos.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.50.2",
    "@gsap/react": "^2.1.1",
    "@sentry/browser": "^7.114.0",
    "@sentry/react": "^7.114.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-virtual": "^3.8.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.8",
    "docx": "^9.7.1",
    "express": "^4.18.2",
    "gsap": "^3.14.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "pdfmake": "^0.2.23",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.3",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "postcss": "^8.4.31",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.7"
  }
}
