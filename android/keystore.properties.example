# Copia este archivo como "keystore.properties" (mismo directorio android/) y
# complétalo con tu keystore de release. NO lo subas a git (ya está en .gitignore).
#
# Para crear el keystore una sola vez (guárdalo en un lugar seguro y respáldalo:
# si lo pierdes, no podrás volver a actualizar la app publicada):
#   keytool -genkey -v -keystore cco-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias cco
#
storeFile=../cco-release.jks
storePassword=TU_PASSWORD_DEL_KEYSTORE
keyAlias=cco
keyPassword=TU_PASSWORD_DE_LA_CLAVE
